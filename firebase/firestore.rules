rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function studentDocPath() {
      return /databases/$(database)/documents/students/$(request.auth.uid);
    }

    function role() {
      return isAuthenticated() && 'role' in request.auth.token
        ? request.auth.token.role
        : (isAuthenticated() && exists(userDocPath())
            ? get(userDocPath()).data.role
            : '');
    }

    function assignedClasses() {
      return isAuthenticated() && 'assigned_classes' in request.auth.token
        ? request.auth.token.assigned_classes
        : (isAuthenticated() && exists(userDocPath())
            && 'assigned_classes' in get(userDocPath()).data
              ? get(userDocPath()).data.assigned_classes
              : []);
    }

    function studentClass() {
      return exists(studentDocPath()) ? get(studentDocPath()).data.class : '';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return role() == 'Admin';
    }

    function isDirector() {
      return role() == 'Director';
    }

    function isTeacher() {
      return role() == 'Teacher';
    }

    function isManager() {
      return isAdmin() || isDirector();
    }

    function isStaff() {
      return isManager() || isTeacher();
    }

    function teacherCanReadClass(className) {
      return isTeacher() && (
        assignedClasses() == null
        || assignedClasses().size() == 0
        || className in assignedClasses()
      );
    }

    function canReadClass(className) {
      return isManager() || teacherCanReadClass(className);
    }

    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isManager();
      allow update: if isManager()
        || (isOwner(userId) && unchanged(['role', 'uid', 'email', 'employee_id', 'is_pre_provisioned', 'assigned_classes']));
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) || isManager();
      }
    }

    match /daily_reports/{reportId} {
      allow read: if isStaff() && (resource.data.createdBy == request.auth.uid || isManager());
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isStaff()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /attendance_records/{recordId} {
      allow read: if isStaff() && (resource.data.createdBy == request.auth.uid || isManager());
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isStaff()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /student_attendance/{logId} {
      allow read: if (isStaff() && (resource.data.markedBy == request.auth.uid || canReadClass(resource.data.class)))
        || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isStaff() && request.resource.data.markedBy == request.auth.uid;
      allow update, delete: if isStaff()
        && (resource.data.markedBy == request.auth.uid || isAdmin());
    }

    match /homework_assignments/{assignmentId} {
      allow read: if isStaff()
        || (isAuthenticated()
            && resource.data.status == 'published'
            && resource.data.class == studentClass());
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isStaff()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /students/{studentId} {
      allow read: if isManager()
        || teacherCanReadClass(resource.data.class)
        || (isAuthenticated() && studentId == request.auth.uid);
      allow write: if isManager();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /exams/{examId} {
      allow read: if isStaff()
        || (isAuthenticated() && resource.data.class == studentClass());
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isStaff()
        && (resource.data.createdBy == request.auth.uid || isManager());
    }

    match /exam_results/{resultId} {
      allow read: if isStaff()
        || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isManager();
    }

    match /audit_logs/{logId} {
      allow read: if isManager()
        || (isStaff() && resource.data.userId == request.auth.uid);
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /error_logs/{logId} {
      allow read: if isManager();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /pending_invites/{email} {
      allow read, write: if false;
    }
  }
}
